# Скопируйте в .env и задайте свои значения.
# Сервер не загружает .env автоматически — передайте переменные окружения
# или используйте `node --env-file=.env server.js` (Node.js 20.6+).

PORT=3000
ADMIN_SECRET=change-me-to-a-long-random-secret
DB_PATH=./geophoto.db
UPLOAD_DIR=./uploads
MAX_PHOTO_BYTES=15728640
CORS_ORIGIN=*
SERVE_CLIENT=true
TRUST_PROXY=false

# Интеграция с файлохранилищем albion-files.
# Можно задать здесь или в server/integration.json.
STORAGE_BASE_URL=http://127.0.0.1:5000
STORAGE_DB_FOLDER_ID=
STORAGE_DB_TOKEN=
# Имя XLSX в папке «база данных»; пусто — берётся самый свежий файл.
STORAGE_LOCATIONS_FILE=
STORAGE_CACHE_DIR=cache
STORAGE_XLSX_CHECK_SECONDS=60
STORAGE_VERIFY_TTL_SECONDS=60
STORAGE_DB_SYNC_MINUTES=15
# Python с парсером XLSX (по умолчанию python3)
PYTHON_BIN=python3
# Путь к JSON-конфигу интеграции (по умолчанию server/integration.json)
INTEGRATION_CONFIG=
